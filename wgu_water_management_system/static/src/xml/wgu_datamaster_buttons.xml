<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Mandat 2026-10-26: tombol Impor + Ekspor khusus list wgu.pelanggan.
         Handler di patch ListController (wgu_datamaster_toolbar.js). -->
    <t t-name="wgu_water_management.WguListViewButtons"
       t-inherit="web.ListView.Buttons"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <t t-if="model.root.resModel === 'wgu.pelanggan'">
                <button type="button" class="btn btn-secondary ms-2" t-on-click="wguImporPelanggan">
                    <i class="fa fa-upload" role="img" aria-label="Impor" title="Impor"/> Impor Data
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="wguEksporPelangganLengkap">
                    <i class="fa fa-file-excel-o" role="img" aria-label="Ekspor" title="Ekspor"/> Ekspor Lengkap (.xlsx)
                </button>
            </t>
        </xpath>
    </t>
</templates>
