<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mandat 2026-10-16 (Tahap Sinkronisasi Waffle):
         Aplikasi "Dashboards" bawaan (spreadsheet_dashboard) blank "No available
         dashboard" → dialihkan ke Dashboard Utama kustom WGU.
         Invoicing/Inventory bawaan Odoo (dummy/template) → diarahkan tegas ke
         halaman Accounting & Chemical Supply kustom WGU (data riil).
         Aplikasi tak terkait (Surveys, Email Marketing, Project) disembunyikan. -->

    <!-- 1) Waffle "Dashboards" -> Dashboard Utama WGU -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="name">Dashboard</field>
        <field name="action" ref="wgu_water_management_system.action_wgu_dashboard_utama"/>
    </record>
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_dashboard" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 2) Waffle "Invoicing" -> halaman Accounting kustom WGU (account.move riil) -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
        <field name="action" ref="wgu_water_management_system.action_wgu_accounting"/>
    </record>
    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="account.menu_finance_payables" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="account.menu_finance_reports" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 3) Waffle "Inventory" -> halaman Chemical Supply kustom WGU -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="name">Chemical Supply</field>
        <field name="action" ref="wgu_water_management_system.action_wgu_chemical"/>
    </record>
    <record id="stock.stock_picking_type_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_stock_warehouse_mgmt" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_stock_inventory_control" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_stock_config_settings" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 4) Sembunyikan aplikasi bawaan lain yang tidak terkait -->
    <record id="survey.menu_surveys" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="mass_mailing.mass_mailing_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 5) Admin WGU wajib melihat aplikasi Accounting: root menu account
         dibatasi grup Billing; tanpa keanggotaan ini menu difilter dari waffle. -->
    <record id="account.group_account_user" model="res.groups">
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
